# Telegram (alertas; sem isto o bot só escreve nos logs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alvo do agendamento. Lisboa e a meta; "Assuncao" serve para testar.
TARGET_CITY=Lisboa
# Janela da manha (HH:MM, fim exclusivo): 08:00 aceita, 12:00 nao.
SLOT_START=08:00
SLOT_END=12:00

# Nivel de urgencia na escolha do DIA (entre os dias com vaga na janela acima):
#   MAX = primeiro dia | MED = dia do meio (n par: o maior dos dois do meio) | MIN = ultimo dia
DATE_URGENCY=MAX

# 1 = preenche o formulario mas NAO carrega em Continuar (nao gasta vaga nem manda PIN)
DRY_RUN=1
# 1 = depois do PIN, confirma tambem a pagina de Revisao
CONFIRM_FINAL=1

# Vigilancia
WATCH_INTERVAL_MIN=10
MAX_ATTEMPTS=3
# Janela rapida: o site liberta vagas as QUINTAS 16:00 (Lisboa) e SEXTAS 12:00 (Assuncao).
# Dentro dela (de BEFORE min antes a AFTER min depois) consulta de BURST_INTERVAL_S em
# BURST_INTERVAL_S segundos. BURST_DAY: 0=segunda ... 3=quinta ... 4=sexta.
BURST=1
BURST_DAY=3
BURST_TIME=16:00
BURST_TZ=Europe/Lisbon
BURST_BEFORE_MIN=5
BURST_AFTER_MIN=30
BURST_INTERVAL_S=30

# PIN por IMAP (Gmail). Gerar App Password em https://myaccount.google.com/apppasswords
# e ativar IMAP no Gmail. Se vazio ou falhar, o bot pede o PIN por Telegram.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
PIN_TIMEOUT_S=240
# Texto que identifica o email do PIN (remetente/assunto/corpo), regex
PIN_HINT=valid\.com|pcdf|services-valid|pol[ií]cia civil|c[oó]digo de valida
